# Copy to .env and adjust. Never commit .env.

# Docker Compose (Postgres container)
POSTGRES_USER=neurax
POSTGRES_PASSWORD=neurax
POSTGRES_DB=neurax
POSTGRES_PORT=5432

# Neurax
DATABASE_URL=postgresql://neurax:neurax@127.0.0.1:5432/neurax
NEURAX_USER_EMAIL=you@example.com
NEURAX_LOG_LEVEL=INFO

# Used from later phases (see docs/ARCHITECTURE.md section 6)
NEURAX_EMBED_MODEL=BAAI/bge-small-en-v1.5
NEURAX_CONFLICT_THRESHOLD=0.80
NEURAX_W_VEC=0.55
NEURAX_W_TEXT=0.25
NEURAX_W_RECENT=0.10
NEURAX_W_PIN=0.10
NEURAX_HALF_LIFE_DAYS=30
